# audiosocket-bridge configuration. Copy to .env and adjust.
# Every value shown is the built-in default unless noted otherwise.

# echo | virtual
BRIDGE_MODE=echo

# AudioSocket listener. Keep this on the private Docker network.
BRIDGE_LISTEN_ADDR=0.0.0.0:9092
# Health, readiness, stats and Prometheus metrics. Set to empty to disable.
BRIDGE_HEALTH_ADDR=0.0.0.0:8080

BRIDGE_LOG_LEVEL=info
BRIDGE_LOG_FORMAT=json

# Audio format spoken with Asterisk.
BRIDGE_CALL_RATE=8000
BRIDGE_FRAME_MS=20ms

# Protocol and buffering limits.
BRIDGE_MAX_FRAME_BYTES=4096
BRIDGE_READ_BUFFER_BYTES=8192
BRIDGE_IN_BUFFER_MS=500
BRIDGE_OUT_QUEUE_FRAMES=50

# Connection lifecycle.
BRIDGE_UUID_TIMEOUT=3s
BRIDGE_READ_TIMEOUT=0
BRIDGE_WRITE_TIMEOUT=10s
BRIDGE_MAX_CALL_DURATION=0
BRIDGE_SHUTDOWN_TIMEOUT=10s

# Aggregate RMS/peak metering. Raw audio is never logged or stored.
BRIDGE_COLLECT_AUDIO_STATS=true

# Spoken call prompts (connected, error, busy) baked into the binary and
# generated with cmd/prompt-tts from an OpenAI-compatible TTS endpoint.
BRIDGE_PROMPTS=true

# Virtual audio mode (PulseAudio or PipeWire with pulse compatibility).
# Phone audio is played into this sink; its monitor is the Chromium mic.
BRIDGE_PA_PLAYBACK_SINK=audiosocket_mic
# Chromium's voice output is captured from this source (sink monitor).
BRIDGE_PA_CAPTURE_SOURCE=audiosocket_spk.monitor
# Open the device at the call rate and let PulseAudio resample. Set to 48000
# only if the device is fixed-rate; the bridge then resamples internally.
BRIDGE_PA_DEVICE_RATE=8000
BRIDGE_PA_DEVICE_CHANNELS=1
BRIDGE_PA_LATENCY=40ms
BRIDGE_PA_OUT_BUFFER_MS=400
BRIDGE_PA_SILENCE_ON_UNDERRUN=true
BRIDGE_PA_PACAT_BIN=pacat
BRIDGE_PA_PAREC_BIN=parec
BRIDGE_PA_RESTART_INITIAL=500ms
BRIDGE_PA_RESTART_MAX=30s
BRIDGE_PA_MAX_RESTARTS=10

# Docker Compose only.
BRIDGE_VERSION=dev
BRIDGE_IMAGE=audiosocket-bridge:latest
BRIDGE_NETWORK_NAME=audiosocket
# Set to true when the network already exists (for example MikoPBX's).
BRIDGE_NETWORK_EXTERNAL=false
PULSE_SERVER=unix:/pulse/native

# --- ChatGPT Voice (camoufox service) -----------------------------------
# The full flow is: BRIDGE_MODE=virtual so the bridge routes call audio into
# the PulseAudio devices, and the camoufox service opens chatgpt.com with a
# persistent profile and starts/stops Voice Mode in step with the call.
# 48 kHz device rate matches the browser's native rate; the bridge resamples
# 8 kHz <-> 48 kHz internally.
BRIDGE_MODE=virtual
BRIDGE_PA_DEVICE_RATE=48000

# Set true only for the first run, to log in through noVNC (port 6080).
CF_LOGIN_ONLY=false
# Voice works anonymously on the ?mode=voice page. Set true to require the
# logged-in profile before calls are served.
CF_REQUIRE_LOGIN=false
# Voice page. Works logged in and anonymously.
CF_URL=https://chatgpt.com/?mode=voice
# Optional VNC password for the one-time login session.
CF_VNC_PASSWORD=
# Poll interval for the bridge call state.
# CF_POLL_MS=500
# Selector overrides if OpenAI changes the voice button DOM:
# CF_VOICE_SELECTOR='button[data-testid="voice"]'
# CF_END_SELECTOR='button[aria-label="End voice chat"]'
